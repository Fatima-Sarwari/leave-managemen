{
  "_version": "1.28.0",
  "sap.app": {
    "id": "leave-management.leave-request-manage",
    "type": "application",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "LeaveService": {
        "uri": "odata/v4/leave/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "LeaveRequests-manage": {
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          },
          "semanticObject": "LeaveRequests",
          "action": "manage",
          "title": "{{appTitle}}",
          "info": "{{appDescription}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://leave-request"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.fe.templates": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "": {
        "dataSource": "LeaveService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "LeaveRequestsList",
          "target": "LeaveRequestsList"
        },
        {
          "pattern": "AllLeaveRequests({key}):?query:",
          "name": "LeaveRequestsDetails",
          "target": "LeaveRequestsDetails"
        }
      ],
      "targets": {
        "LeaveRequestsList": {
          "type": "Component",
          "id": "LeaveRequestsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "AllLeaveRequests",
              "liveMode": true,
              "navigation": {
                "AllLeaveRequests": {
                  "detail": {
                    "route": "LeaveRequestsDetails"
                  }
                }
              }
            }
          }
        },
        "LeaveRequestsDetails": {
          "type": "Component",
          "id": "LeaveRequestsDetailsList",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "AllLeaveRequests",
              "editableHeaderContent": false
            }
          }
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
